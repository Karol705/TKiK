    (50) expr -> expr . AMP AMP expr
    (51) expr -> expr . EQ expr
    (52) expr -> expr . NEQ expr
    (53) expr -> expr . LT expr
    (54) expr -> expr . GT expr
    (55) expr -> expr . LEQ expr
    (56) expr -> expr . GEQ expr
    (57) expr -> expr . PLUS expr
    (58) expr -> expr . MINUS expr
    (59) expr -> expr . STAR expr
    (60) expr -> expr . SLASH expr
    (61) expr -> expr . PERCENT expr
    (74) expr -> expr . DOT IDENT LPAREN arg_list RPAREN

    SEMICOLON       reduce using rule 35 (opt_init -> ASSIGN expr .)
    OR              shift and go to state 61
    AMP             shift and go to state 62
    EQ              shift and go to state 63
    NEQ             shift and go to state 64
    LT              shift and go to state 65
    GT              shift and go to state 66
    LEQ             shift and go to state 67
    GEQ             shift and go to state 68
    PLUS            shift and go to state 69
    MINUS           shift and go to state 70
    STAR            shift and go to state 71
    SLASH           shift and go to state 72
    PERCENT         shift and go to state 73
    DOT             shift and go to state 74

